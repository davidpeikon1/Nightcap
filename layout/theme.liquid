<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — Nightcap</title>
  <meta name="description" content="{{ page_description | default: 'Nightcap — The better way to wind down. Join the waitlist for our coming-soon beverage.' }}">
  <meta name="theme-color" content="#0a0a12">

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#127769;</text></svg>">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ 'nightcap-landing.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body>
  {{ content_for_layout }}

  {{ 'nightcap-quiz.js' | asset_url | script_tag }}
  {{ 'nightcap-waitlist.js' | asset_url | script_tag }}

  <!-- Scroll Reveal Observer -->
  <script>
  (function () {
    var reveals = document.querySelectorAll('.nc-reveal');
    if (!reveals.length || !('IntersectionObserver' in window)) {
      reveals.forEach(function (el) { el.classList.add('visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function (el) { observer.observe(el); });
  })();
  </script>
</body>
</html>
