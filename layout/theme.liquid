<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — Nightcap</title>
  <meta name="description" content="{{ page_description | default: 'Nightcap — The better way to wind down. Join the waitlist for our coming-soon beverage.' }}">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ 'nightcap-landing.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body>
  {{ content_for_layout }}

  {{ 'nightcap-quiz.js' | asset_url | script_tag }}
  {{ 'nightcap-waitlist.js' | asset_url | script_tag }}
</body>
</html>
