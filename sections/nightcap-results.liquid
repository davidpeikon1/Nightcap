<section class="nc-results" id="quiz-results" style="display: none;">
  <div class="nc-results__container">
    <!-- Personalized Sugar Report -->
    <div class="nc-results__report">
      <div class="nc-results__score-ring">
        <svg viewBox="0 0 120 120" class="nc-results__ring-svg">
          <circle cx="60" cy="60" r="54" class="nc-results__ring-bg"/>
          <circle cx="60" cy="60" r="54" class="nc-results__ring-fill" id="results-ring"/>
        </svg>
        <div class="nc-results__score-value">
          <span id="results-sugar-grams">0</span>g
        </div>
      </div>

      <h2 class="nc-results__title" id="results-title">Your Daily Sugar Snapshot</h2>
      <p class="nc-results__subtitle" id="results-subtitle"></p>

      <!-- Sugar Breakdown -->
      <div class="nc-results__breakdown">
        <div class="nc-results__stat">
          <span class="nc-results__stat-number" id="results-daily-sugar">0g</span>
          <span class="nc-results__stat-label">Estimated daily sugar from drinks</span>
        </div>
        <div class="nc-results__stat">
          <span class="nc-results__stat-number" id="results-weekly-sugar">0g</span>
          <span class="nc-results__stat-label">That's per week</span>
        </div>
        <div class="nc-results__stat">
          <span class="nc-results__stat-number" id="results-yearly-sugar">0 lbs</span>
          <span class="nc-results__stat-label">Sugar from drinks per year</span>
        </div>
      </div>

      <!-- Personalized Insight -->
      <div class="nc-results__insight" id="results-insight">
        <div class="nc-results__insight-icon">💡</div>
        <p id="results-insight-text"></p>
      </div>
    </div>

    <!-- Nightcap CTA -->
    <div class="nc-results__cta-card">
      <h3 class="nc-results__cta-title">Nightcap: Your Better Evening Ritual</h3>
      <ul class="nc-results__benefits">
        <li>✓ 0g sugar — naturally sweetened</li>
        <li>✓ Functional ingredients for relaxation & sleep</li>
        <li>✓ Replaces sugary evening drinks</li>
        <li>✓ Tastes incredible — not like "health food"</li>
      </ul>
      <div class="nc-results__cta-actions">
        <button class="nc-btn nc-btn--primary nc-btn--full" id="download-app-btn">
          📲 Get the Nightcap App
        </button>
        <p class="nc-results__cta-note" id="results-sms-note">
          We'll also text you a personalized download link!
        </p>
      </div>
    </div>

    <!-- Share Section -->
    <div class="nc-results__share">
      <p class="nc-results__share-label">Think a friend needs to see their sugar intake?</p>
      <div class="nc-results__share-buttons">
        <button class="nc-btn nc-btn--outline nc-btn--sm" id="share-quiz-btn">
          Share the Quiz
        </button>
        <button class="nc-btn nc-btn--outline nc-btn--sm" id="refer-friend-btn">
          Refer a Friend — Skip the Line
        </button>
      </div>
    </div>

    <!-- Waitlist Position -->
    <div class="nc-results__position">
      <p>You're <strong>#<span id="results-position">2,848</span></strong> on the waitlist</p>
      <p class="nc-results__position-note">Refer friends to move up! Each referral bumps you 10 spots.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quiz Results",
  "settings": [
    {
      "type": "text",
      "id": "results_heading",
      "label": "Results Heading",
      "default": "Your Daily Sugar Snapshot"
    }
  ]
}
{% endschema %}
