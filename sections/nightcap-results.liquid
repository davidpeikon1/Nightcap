<section class="nc-results" id="quiz-results" aria-labelledby="results-title">
  <div class="nc-results__container">
    <div class="nc-results__report">
      <div class="nc-results__score-ring" aria-label="Sugar score visualization">
        <svg viewBox="0 0 120 120" class="nc-results__ring-svg" role="img" aria-label="Sugar intake ring chart">
          <defs>
            <linearGradient id="ring-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#2A2520"/>
              <stop offset="100%" stop-color="#5C554C"/>
            </linearGradient>
          </defs>
          <circle cx="60" cy="60" r="54" class="nc-results__ring-bg"/>
          <circle cx="60" cy="60" r="54" class="nc-results__ring-fill" id="results-ring"/>
        </svg>
        <div class="nc-results__score-value">
          <span id="results-sugar-grams">0</span>g
        </div>
      </div>
      <h2 class="nc-results__title" id="results-title">Your Processed Sugar Report</h2>
      <p class="nc-results__subtitle" id="results-subtitle"></p>

      <div class="nc-results__breakdown">
        <div class="nc-results__stat">
          <span class="nc-results__stat-number" id="results-daily-sugar">0g</span>
          <span class="nc-results__stat-label">Daily processed sugar</span>
        </div>
        <div class="nc-results__stat">
          <span class="nc-results__stat-number" id="results-weekly-sugar">0g</span>
          <span class="nc-results__stat-label">Per week</span>
        </div>
        <div class="nc-results__stat">
          <span class="nc-results__stat-number" id="results-yearly-sugar">0 lbs</span>
          <span class="nc-results__stat-label">Per year</span>
        </div>
      </div>

      <!-- Sugar Equivalents -->
      <div class="nc-equivalents" id="results-equivalents">
        <h3 class="nc-equivalents__title">That's the same as eating</h3>
        <div class="nc-equivalents__grid">
          <div class="nc-equivalents__item">
            <span class="nc-equivalents__emoji" aria-hidden="true">&#127849;</span>
            <span class="nc-equivalents__value" id="equiv-donuts">0</span>
            <span class="nc-equivalents__label">donuts per day</span>
          </div>
          <div class="nc-equivalents__item">
            <span class="nc-equivalents__emoji" aria-hidden="true">&#127852;</span>
            <span class="nc-equivalents__value" id="equiv-cookies">0</span>
            <span class="nc-equivalents__label">cookies per day</span>
          </div>
          <div class="nc-equivalents__item">
            <span class="nc-equivalents__emoji" aria-hidden="true">&#127851;</span>
            <span class="nc-equivalents__value" id="equiv-candy">0</span>
            <span class="nc-equivalents__label">candy bars per year</span>
          </div>
        </div>
      </div>

      <!-- Sugar Source Breakdown -->
      <div class="nc-sources" id="results-sources">
        <h3 class="nc-sources__title">Where Your Sugar Comes From</h3>
        <div class="nc-sources__list">
          <div class="nc-sources__item">
            <span class="nc-sources__item-label">Breakfast</span>
            <div class="nc-sources__item-bar-track">
              <div class="nc-sources__item-bar nc-sources__item-bar--breakfast" id="source-bar-breakfast" style="width: 0%">
                <span class="nc-sources__item-value" id="source-val-breakfast">0g</span>
              </div>
            </div>
          </div>
          <div class="nc-sources__item">
            <span class="nc-sources__item-label">Drinks</span>
            <div class="nc-sources__item-bar-track">
              <div class="nc-sources__item-bar nc-sources__item-bar--drinks" id="source-bar-drinks" style="width: 0%">
                <span class="nc-sources__item-value" id="source-val-drinks">0g</span>
              </div>
            </div>
          </div>
          <div class="nc-sources__item">
            <span class="nc-sources__item-label">Packaged food</span>
            <div class="nc-sources__item-bar-track">
              <div class="nc-sources__item-bar nc-sources__item-bar--processed" id="source-bar-processed" style="width: 0%">
                <span class="nc-sources__item-value" id="source-val-processed">0g</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Comparison Chart -->
      <div class="nc-compare" id="results-compare">
        <h3 class="nc-compare__title">How You Compare</h3>
        <div class="nc-compare__bars">
          <div class="nc-compare__row">
            <span class="nc-compare__label">You</span>
            <div class="nc-compare__bar-track">
              <div class="nc-compare__bar nc-compare__bar--you" id="compare-bar-you" style="width: 0%">
                <span class="nc-compare__bar-value" id="compare-value-you">0g</span>
              </div>
            </div>
          </div>
          <div class="nc-compare__row">
            <span class="nc-compare__label">Avg. American</span>
            <div class="nc-compare__bar-track">
              <div class="nc-compare__bar nc-compare__bar--avg" style="width: 0%">
                <span class="nc-compare__bar-value">190g</span>
              </div>
            </div>
          </div>
          <div class="nc-compare__row">
            <span class="nc-compare__label">Recommended</span>
            <div class="nc-compare__bar-track">
              <div class="nc-compare__bar nc-compare__bar--nc" style="width: 0%">
                <span class="nc-compare__bar-value">&lt;25g</span>
              </div>
            </div>
          </div>
        </div>
        <p class="nc-compare__footnote">Daily processed sugar intake (grams)</p>
      </div>

      <div class="nc-results__insight" id="results-insight">
        <div class="nc-results__insight-icon" aria-hidden="true">&#128161;</div>
        <p id="results-insight-text"></p>
      </div>
    </div>

    <!-- Personalized Next Steps -->
    <div class="nc-next-steps" id="results-next-steps">
      <h3 class="nc-next-steps__title">Your 3 Next Steps</h3>
      <div class="nc-next-steps__list">
        <div class="nc-next-steps__item">
          <div class="nc-next-steps__number">1</div>
          <div class="nc-next-steps__content">
            <h4 class="nc-next-steps__heading" id="next-step-1-title">Start reading labels</h4>
            <p class="nc-next-steps__desc" id="next-step-1-desc">Check the "Added Sugars" line on everything you buy this week.</p>
          </div>
        </div>
        <div class="nc-next-steps__item">
          <div class="nc-next-steps__number">2</div>
          <div class="nc-next-steps__content">
            <h4 class="nc-next-steps__heading" id="next-step-2-title">Track for 7 days</h4>
            <p class="nc-next-steps__desc" id="next-step-2-desc">Use the Nightcap app to log your daily sugar intake.</p>
          </div>
        </div>
        <div class="nc-next-steps__item">
          <div class="nc-next-steps__number">3</div>
          <div class="nc-next-steps__content">
            <h4 class="nc-next-steps__heading" id="next-step-3-title">Make one swap</h4>
            <p class="nc-next-steps__desc" id="next-step-3-desc">Pick your biggest sugar source and find one alternative.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Share Card -->
    <div class="nc-share-card" id="share-card">
      <div class="nc-share-card__inner" id="share-card-inner">
        <div class="nc-share-card__header">
          <span class="nc-share-card__logo">NIGHTCAP</span>
          <span class="nc-share-card__badge">Sugar Quiz Results</span>
        </div>
        <div class="nc-share-card__body">
          <div class="nc-share-card__big-number" id="share-card-sugar">0g</div>
          <div class="nc-share-card__label">processed sugar per day</div>
          <div class="nc-share-card__divider"></div>
          <div class="nc-share-card__stats">
            <div class="nc-share-card__stat">
              <span class="nc-share-card__stat-val" id="share-card-weekly">0g</span>
              <span class="nc-share-card__stat-lbl">/ week</span>
            </div>
            <div class="nc-share-card__stat">
              <span class="nc-share-card__stat-val" id="share-card-yearly">0 lbs</span>
              <span class="nc-share-card__stat-lbl">/ year</span>
            </div>
          </div>
        </div>
        <div class="nc-share-card__footer">
          <span>Find out yours: nightcap.com/quiz</span>
        </div>
      </div>
      <button class="nc-btn nc-btn--outline nc-btn--sm nc-share-card__save" id="save-share-card">&#128247; Save &amp; Share on Stories</button>
    </div>

    <!-- CTA -->
    <div class="nc-results__cta-card">
      <h3 class="nc-results__cta-title">Ready to Take Control?</h3>
      <ul class="nc-results__benefits">
        <li>&#10003; Track your daily processed sugar intake</li>
        <li>&#10003; Spot hidden sugar sources in your diet</li>
        <li>&#10003; Set reduction goals and build new habits</li>
        <li>&#10003; Join a community eliminating processed sugar</li>
      </ul>
      <div class="nc-results__cta-actions">
        <button class="nc-btn nc-btn--primary nc-btn--full" id="download-app-btn">&#128242; Get the Nightcap App</button>
        <p class="nc-results__cta-note" id="results-sms-note">We'll text you a link to start tracking.</p>
      </div>
    </div>

    <!-- Referral -->
    <div class="nc-results__referral">
      <h3 class="nc-results__referral-title">Help Someone Else See Their Number</h3>
      <p class="nc-results__referral-subtitle">Share the quiz. The first step to change is awareness — and you can give that to someone you care about.</p>
      <div class="nc-referral-link">
        <input type="text" class="nc-referral-link__input" id="referral-url" readonly aria-label="Your referral link">
        <button class="nc-referral-link__copy" id="referral-copy-btn" aria-label="Copy referral link">Copy</button>
      </div>
      <div class="nc-referral-socials">
        <button class="nc-referral-socials__btn" id="share-twitter" aria-label="Share on Twitter">&#120143; Post</button>
        <button class="nc-referral-socials__btn" id="share-sms" aria-label="Share via text">&#128172; Text a Friend</button>
        <button class="nc-referral-socials__btn" id="share-email" aria-label="Share via email">&#9993; Email</button>
      </div>
    </div>

    <div class="nc-results__share">
      <p class="nc-results__share-label">Know someone who needs to see their number?</p>
      <div class="nc-results__share-buttons">
        <button class="nc-btn nc-btn--outline nc-btn--sm" id="share-quiz-btn">Share the Quiz</button>
      </div>
    </div>

    <div class="nc-results__position">
      <p><strong><span id="results-position">2,848</span></strong> people are working to eliminate processed sugar</p>
      <p class="nc-results__position-note">You're one of them now.</p>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Quiz Results", "settings": [] }
{% endschema %}
