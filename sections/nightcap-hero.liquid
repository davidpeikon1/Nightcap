<a href="#sugar-quiz" class="nc-skip-link">Skip to quiz</a>

<section class="nc-hero" id="hero" aria-labelledby="hero-title">
  <div class="nc-hero__bg" aria-hidden="true">
    <div class="nc-hero__gradient"></div>
    <div class="nc-hero__stars"></div>
  </div>
  <div class="nc-hero__content">
    <div class="nc-logo" aria-label="Nightcap">
      <div class="nc-logo__lines"></div>
      <span class="nc-logo__text">NIGHTCAP</span>
      <div class="nc-logo__lines"></div>
    </div>

    <h1 class="nc-hero__title" id="hero-title">
      <span class="nc-hero__title-line">How Much Processed Sugar</span>
      <span class="nc-hero__title-line nc-hero__title-line--accent">Are You Really Consuming?</span>
    </h1>
    <p class="nc-hero__subtitle">
      200 years ago, Americans consumed 1 pound of sugar per year.
      Today it's 152 pounds. Most people have no idea how much they're actually eating.
      Find out in 60 seconds.
    </p>

    <div class="nc-hero__cta-group">
      <button class="nc-btn nc-btn--primary nc-btn--pulse" id="start-quiz-btn" aria-label="Start the Sugar Quiz">
        Take the Sugar Quiz
        <span class="nc-btn__arrow" aria-hidden="true">&#8594;</span>
      </button>
      <p class="nc-hero__cta-note">60 seconds. No sign-up required. See your real number.</p>
    </div>
    <div class="nc-hero__social-proof">
      <div class="nc-hero__avatars" aria-hidden="true">
        <div class="nc-avatar">D</div>
        <div class="nc-avatar">M</div>
        <div class="nc-avatar">S</div>
        <div class="nc-avatar">+</div>
      </div>
      <span class="nc-hero__waitlist-count">
        <strong id="waitlist-count">{{ section.settings.quiz_count | default: '2,847' }}</strong> people have taken the quiz
      </span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nightcap Hero",
  "settings": [
    {
      "type": "text",
      "id": "quiz_count",
      "label": "Quiz Count (display)",
      "default": "2,847"
    }
  ]
}
{% endschema %}
