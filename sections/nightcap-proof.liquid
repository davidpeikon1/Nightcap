<section class="nc-proof nc-reveal" id="social-proof" aria-labelledby="proof-title">
  <div class="nc-proof__container">
    <h2 class="nc-proof__title" id="proof-title">You're Not Alone in This</h2>
    <div class="nc-proof__grid">
      {% for block in section.blocks %}
        <div class="nc-proof__card nc-reveal nc-reveal--delay-{{ forloop.index }}">
          <p class="nc-proof__quote">"{{ block.settings.quote }}"</p>
          <div class="nc-proof__author">
            <div class="nc-proof__avatar">{{ block.settings.name | slice: 0 }}</div>
            <div>
              <span class="nc-proof__name">{{ block.settings.name }}</span>
              <span class="nc-proof__detail">{{ block.settings.detail }}</span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "You're Not Alone",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "detail", "label": "Detail" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Seeing my actual number — 94g a day — changed everything. I wasn't weak. I just didn't know where it was all hiding.", "name": "Sarah M.", "detail": "NYC" } },
        { "type": "testimonial", "settings": { "quote": "The 3pm crash, the brain fog — I thought that was just aging. Three weeks off processed sugar, all of it was gone.", "name": "David K.", "detail": "Austin" } },
        { "type": "testimonial", "settings": { "quote": "My husband thought he was fine because he doesn't eat candy. His bread, sauces, and protein bars? 72g a day. Now we're doing it together.", "name": "Michelle T.", "detail": "LA" } }
      ]
    }
  ]
}
{% endschema %}
