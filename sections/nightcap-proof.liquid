<section class="nc-proof nc-reveal" id="social-proof" aria-labelledby="proof-title">
  <div class="nc-proof__container">
    <h2 class="nc-proof__title" id="proof-title">What People Say After Taking the Quiz</h2>
    <div class="nc-proof__grid">
      {% for block in section.blocks %}
        <div class="nc-proof__card nc-reveal nc-reveal--delay-{{ forloop.index }}">
          <div class="nc-proof__stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="nc-proof__quote">"{{ block.settings.quote }}"</p>
          <div class="nc-proof__author">
            <div class="nc-proof__avatar">{{ block.settings.name | slice: 0 }}</div>
            <div>
              <span class="nc-proof__name">{{ block.settings.name }}</span>
              <span class="nc-proof__detail">{{ block.settings.detail }}</span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Proof",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name", "default": "Sarah M." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Quiz Taker" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "I thought I was eating healthy. Turns out my 'healthy' granola, oat milk, and kombucha add up to 68g of sugar a day. This quiz was a wake-up call.", "name": "Sarah M.", "detail": "Quiz Taker · NYC" } },
        { "type": "testimonial", "settings": { "quote": "Seeing my yearly number — 47 lbs of processed sugar — hit different. I started reading labels the next day. That awareness alone changed my habits.", "name": "David K.", "detail": "Quiz Taker · Austin" } },
        { "type": "testimonial", "settings": { "quote": "I sent this to my whole family. My dad had no idea his 'heart-healthy' orange juice was giving him 30g of sugar every morning. He stopped that week.", "name": "Michelle T.", "detail": "Quiz Taker · LA" } }
      ]
    }
  ]
}
{% endschema %}
