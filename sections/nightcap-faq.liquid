<section class="nc-faq nc-reveal" id="faq" aria-labelledby="faq-title">
  <div class="nc-faq__container">
    <h2 class="nc-faq__title" id="faq-title">Questions? We've Got Answers.</h2>
    <div class="nc-faq__list">
      {% for block in section.blocks %}
        <details class="nc-faq__item" {{ block.shopify_attributes }}>
          <summary class="nc-faq__question">{{ block.settings.question }}</summary>
          <div class="nc-faq__answer">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "What is Nightcap?", "answer": "Nightcap is on a mission to help America eliminate processed sugar. We're building tools — starting with this quiz and our tracking app — to help people see, understand, and reduce the processed sugar in their diet before it becomes a health problem." } },
        { "type": "question", "settings": { "question": "Why does processed sugar matter?", "answer": "Americans now consume 152 pounds of sugar per person per year — up from about 1 pound just 200 years ago. This explosion is linked to metabolic dysfunction, type 2 diabetes, heart disease, and chronic inflammation. 88% of Americans are already metabolically unhealthy." } },
        { "type": "question", "settings": { "question": "How accurate is the quiz?", "answer": "The quiz gives you a science-based estimate of your daily processed sugar intake based on your eating and drinking habits. It's not a medical test — it's a wake-up call." } },
        { "type": "question", "settings": { "question": "What does the Nightcap app do?", "answer": "The app helps you track your daily processed sugar intake, identify hidden sources in your diet, set reduction goals, and build new habits." } },
        { "type": "question", "settings": { "question": "Is this just about drinks?", "answer": "No. Processed sugar is everywhere — cereal, bread, sauces, yogurt, protein bars. Our mission covers all sources. We start with awareness (quiz), then daily tracking (app), and eventually better alternatives." } },
        { "type": "question", "settings": { "question": "What do I get when I sign up?", "answer": "Your personalized sugar report, early access to the Nightcap app, and membership in a growing community of people taking control of their sugar intake before it becomes a problem." } }
      ]
    }
  ]
}
{% endschema %}
