<section class="nc-faq nc-reveal" id="faq" aria-labelledby="faq-title">
  <div class="nc-faq__container">
    <h2 class="nc-faq__title" id="faq-title">Questions</h2>
    <div class="nc-faq__list">
      {% for block in section.blocks %}
        <details class="nc-faq__item" {{ block.shopify_attributes }}>
          <summary class="nc-faq__question">{{ block.settings.question }}</summary>
          <div class="nc-faq__answer">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "I've tried quitting sugar before. Why would this be different?", "answer": "Willpower alone doesn't work. Sugar is addictive and hidden in 73% of packaged foods. Nightcap gives you the awareness to see it, the tools to track it, and eventually products that replace the craving at its source." } },
        { "type": "question", "settings": { "question": "I don't eat that much sugar — do I need this?", "answer": "That's what everyone says before the quiz. Most \"healthy eaters\" discover they're consuming 2-4x the recommended amount. Take 60 seconds and see." } },
        { "type": "question", "settings": { "question": "What is Nightcap?", "answer": "A complete system to help you leave processed sugar behind. Awareness (this quiz), daily tracking (the app), and eventually products that replace cravings at their source. Not a diet. Not a fad." } },
        { "type": "question", "settings": { "question": "Will I have to give up everything I enjoy?", "answer": "No. It's about replacing processed sugar with things that make you feel better. Most people find that once they spot where sugar is hiding, they don't miss it." } },
        { "type": "question", "settings": { "question": "What happens after the quiz?", "answer": "Your personalized sugar report — daily, weekly, and yearly intake broken down by source. A specific action plan. Early access to the Nightcap app and community." } },
        { "type": "question", "settings": { "question": "Is my data private?", "answer": "Yes. Never sold, shared, or used for ads. Unsubscribe anytime." } }
      ]
    }
  ]
}
{% endschema %}
