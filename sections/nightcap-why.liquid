<section class="nc-why nc-reveal" id="why" aria-labelledby="why-title">
  <div class="nc-why__container">
    <div class="nc-badge">It's Not Your Fault</div>
    <h2 class="nc-why__title" id="why-title">You've tried. <span class="nc-why__highlight">It didn't stick.</span></h2>
    <p class="nc-why__subtitle">The cravings always come back. That's because 73% of packaged foods contain added sugar — and the system is designed to keep you hooked.</p>
    <div class="nc-why__stats">
      <div class="nc-why__stat">
        <span class="nc-why__stat-number" data-count-to="152">1</span>
        <span class="nc-why__stat-label">lbs of sugar per person per year</span>
      </div>
      <div class="nc-why__stat">
        <span class="nc-why__stat-number" data-count-to="73">0</span>
        <span class="nc-why__stat-label">% of packaged foods contain added sugar</span>
      </div>
      <div class="nc-why__stat">
        <span class="nc-why__stat-number" data-count-to="60">0</span>
        <span class="nc-why__stat-label">+ names sugar hides behind on labels</span>
      </div>
    </div>
    <button class="nc-btn nc-btn--primary" id="why-quiz-btn">
      See Where I Stand <span class="nc-btn__arrow" aria-hidden="true">&#8594;</span>
    </button>
  </div>
</section>

{% schema %}
{ "name": "It's Not Your Fault", "settings": [] }
{% endschema %}
