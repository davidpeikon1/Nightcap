<section class="nc-why nc-reveal" id="why" aria-labelledby="why-title">
  <div class="nc-why__container">
    <div class="nc-badge">The Problem</div>
    <h2 class="nc-why__title" id="why-title">The average American drinks <span class="nc-why__highlight">77 lbs</span> of sugar per year</h2>
    <p class="nc-why__subtitle">Most of it comes from beverages. Evening drinks are the worst offenders — soda, juice, alcohol, sweetened coffee. They wreck your sleep, spike your blood sugar, and leave you feeling worse the next day.</p>
    <div class="nc-why__stats">
      <div class="nc-why__stat">
        <span class="nc-why__stat-number">39g</span>
        <span class="nc-why__stat-label">Sugar in one can of soda</span>
      </div>
      <div class="nc-why__stat">
        <span class="nc-why__stat-number">2x</span>
        <span class="nc-why__stat-label">More sugar than the daily recommended limit</span>
      </div>
      <div class="nc-why__stat">
        <span class="nc-why__stat-number">73%</span>
        <span class="nc-why__stat-label">Of people underestimate their sugar intake</span>
      </div>
    </div>
    <button class="nc-btn nc-btn--primary" id="why-quiz-btn" aria-label="Take the quiz to find out your sugar intake">
      Find Out Your Number <span class="nc-btn__arrow" aria-hidden="true">&#8594;</span>
    </button>
  </div>
</section>

{% schema %}
{ "name": "Why Section", "settings": [] }
{% endschema %}
