<section class="nc-calculating" id="calculating-screen" aria-live="polite">
  <div class="nc-calculating__container">
    <div class="nc-calculating__ring">
      <svg viewBox="0 0 80 80" class="nc-calculating__svg">
        <defs>
          <linearGradient id="calc-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#2A2520"/>
            <stop offset="100%" stop-color="#5C554C"/>
          </linearGradient>
        </defs>
        <circle cx="40" cy="40" r="34" class="nc-calculating__track"/>
        <circle cx="40" cy="40" r="34" class="nc-calculating__spinner"/>
      </svg>
    </div>
    <h2 class="nc-calculating__title" id="calculating-text">Analyzing your sugar intake...</h2>
    <div class="nc-calculating__steps">
      <p class="nc-calculating__step" data-calc-step="1">Calculating daily processed sugar intake...</p>
      <p class="nc-calculating__step" data-calc-step="2">Comparing to the 152 lb national average...</p>
      <p class="nc-calculating__step" data-calc-step="3">Building your personalized sugar report...</p>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Calculating Transition", "settings": [] }
{% endschema %}
