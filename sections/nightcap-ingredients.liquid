<section class="nc-ingredients nc-reveal" id="ingredients" aria-labelledby="ingredients-title">
  <div class="nc-ingredients__container">
    <div class="nc-badge">What's Inside</div>
    <h2 class="nc-ingredients__title" id="ingredients-title">Ingredients That Actually Do Something</h2>
    <p class="nc-ingredients__subtitle">No filler. No artificial anything. Every ingredient is here for a reason.</p>
    <div class="nc-ingredients__grid">
      <div class="nc-ingredients__card">
        <div class="nc-ingredients__card-icon" aria-hidden="true">&#129497;</div>
        <h3 class="nc-ingredients__card-title">Magnesium Glycinate</h3>
        <p class="nc-ingredients__card-desc">Relaxes muscles and calms the nervous system. 80% of people are deficient.</p>
        <span class="nc-ingredients__card-tag">Relaxation</span>
      </div>
      <div class="nc-ingredients__card">
        <div class="nc-ingredients__card-icon" aria-hidden="true">&#127861;</div>
        <h3 class="nc-ingredients__card-title">L-Theanine</h3>
        <p class="nc-ingredients__card-desc">Found in green tea. Promotes alpha brain waves — alert calm without drowsiness.</p>
        <span class="nc-ingredients__card-tag">Focus &amp; Calm</span>
      </div>
      <div class="nc-ingredients__card">
        <div class="nc-ingredients__card-icon" aria-hidden="true">&#127804;</div>
        <h3 class="nc-ingredients__card-title">Chamomile Extract</h3>
        <p class="nc-ingredients__card-desc">Clinically shown to reduce anxiety and improve sleep quality by 30%.</p>
        <span class="nc-ingredients__card-tag">Sleep</span>
      </div>
      <div class="nc-ingredients__card">
        <div class="nc-ingredients__card-icon" aria-hidden="true">&#127807;</div>
        <h3 class="nc-ingredients__card-title">Ashwagandha KSM-66</h3>
        <p class="nc-ingredients__card-desc">Gold-standard adaptogen. Reduces cortisol by up to 30% in clinical trials.</p>
        <span class="nc-ingredients__card-tag">Stress Relief</span>
      </div>
    </div>
  </div>
</section>

