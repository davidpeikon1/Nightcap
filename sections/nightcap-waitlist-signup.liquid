<section class="nc-signup" id="waitlist-signup" style="display: none;">
  <div class="nc-signup__container">
    <div class="nc-signup__header">
      <div class="nc-signup__icon">🎉</div>
      <h2 class="nc-signup__title">Your Results Are Ready!</h2>
      <p class="nc-signup__subtitle">
        Enter your info below to see your personalized sugar report
        and get early access to Nightcap.
      </p>
    </div>

    <form id="waitlist-form" class="nc-signup__form" novalidate>
      <!-- First Name -->
      <div class="nc-form-group">
        <label class="nc-label" for="signup-name">First Name</label>
        <input
          type="text"
          id="signup-name"
          name="first_name"
          class="nc-input"
          placeholder="Your first name"
          required
          autocomplete="given-name"
        >
        <span class="nc-input-error" id="name-error"></span>
      </div>

      <!-- Email -->
      <div class="nc-form-group">
        <label class="nc-label" for="signup-email">Email Address</label>
        <input
          type="email"
          id="signup-email"
          name="email"
          class="nc-input"
          placeholder="you@example.com"
          required
          autocomplete="email"
        >
        <span class="nc-input-error" id="email-error"></span>
      </div>

      <!-- Phone / SMS -->
      <div class="nc-form-group">
        <label class="nc-label" for="signup-phone">
          Phone Number
          <span class="nc-label__badge">Get a text when we launch</span>
        </label>
        <input
          type="tel"
          id="signup-phone"
          name="phone"
          class="nc-input"
          placeholder="(555) 123-4567"
          autocomplete="tel"
        >
        <span class="nc-input-error" id="phone-error"></span>
      </div>

      <!-- SMS Consent -->
      <div class="nc-form-group nc-form-group--checkbox">
        <label class="nc-checkbox">
          <input type="checkbox" id="sms-consent" name="sms_consent" checked>
          <span class="nc-checkbox__mark"></span>
          <span class="nc-checkbox__text">
            Yes, text me my results + a link to download the Nightcap app.
            <span class="nc-checkbox__legal">Msg & data rates may apply. Reply STOP to unsubscribe.</span>
          </span>
        </label>
      </div>

      <!-- Email Consent -->
      <div class="nc-form-group nc-form-group--checkbox">
        <label class="nc-checkbox">
          <input type="checkbox" id="email-consent" name="email_consent" checked>
          <span class="nc-checkbox__mark"></span>
          <span class="nc-checkbox__text">
            Send me early access updates and exclusive offers via email.
          </span>
        </label>
      </div>

      <button type="submit" class="nc-btn nc-btn--primary nc-btn--full" id="signup-submit-btn">
        <span class="nc-btn__text">See My Results & Join Waitlist</span>
        <span class="nc-btn__loading" style="display: none;">
          <span class="nc-spinner"></span> Saving...
        </span>
      </button>

      <p class="nc-signup__privacy">
        🔒 We respect your privacy. Unsubscribe anytime.
      </p>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Waitlist Signup",
  "settings": [
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Signup Heading",
      "default": "Your Results Are Ready!"
    },
    {
      "type": "textarea",
      "id": "signup_subheading",
      "label": "Signup Sub-heading",
      "default": "Enter your info below to see your personalized sugar report and get early access to Nightcap."
    }
  ]
}
{% endschema %}
