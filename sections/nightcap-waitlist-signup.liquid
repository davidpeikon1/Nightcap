<section class="nc-signup" id="waitlist-signup" aria-labelledby="signup-title">
  <div class="nc-signup__container">
    <div class="nc-signup__header">
      <div class="nc-signup__icon" aria-hidden="true">&#127881;</div>
      <h2 class="nc-signup__title" id="signup-title">Your Results Are Ready</h2>
      <p class="nc-signup__subtitle">
        Enter your info to see your personalized sugar report
        and get access to tools that help you reduce processed sugar.
      </p>
    </div>
    <form id="waitlist-form" class="nc-signup__form" novalidate>
      <div class="nc-form-group">
        <label class="nc-label" for="signup-name">First Name</label>
        <input type="text" id="signup-name" name="first_name" class="nc-input"
               placeholder="Your first name" required autocomplete="given-name"
               aria-describedby="name-error" aria-required="true">
        <span class="nc-input-error" id="name-error" aria-live="polite"></span>
      </div>
      <div class="nc-form-group">
        <label class="nc-label" for="signup-email">Email Address</label>
        <input type="email" id="signup-email" name="email" class="nc-input"
               placeholder="you@example.com" required autocomplete="email"
               aria-describedby="email-error" aria-required="true">
        <span class="nc-input-error" id="email-error" aria-live="polite"></span>
      </div>
      <div class="nc-form-group">
        <label class="nc-label" for="signup-phone">
          Phone Number
          <span class="nc-label__badge">Get a text when the app launches</span>
        </label>
        <input type="tel" id="signup-phone" name="phone" class="nc-input"
               placeholder="(555) 123-4567" autocomplete="tel"
               aria-describedby="phone-error">
        <span class="nc-input-error" id="phone-error" aria-live="polite"></span>
      </div>
      <div class="nc-form-group nc-form-group--checkbox">
        <label class="nc-checkbox">
          <input type="checkbox" id="sms-consent" name="sms_consent" checked>
          <span class="nc-checkbox__mark" aria-hidden="true"></span>
          <span class="nc-checkbox__text">
            Yes, text me my results and a link to the Nightcap app.
            <span class="nc-checkbox__legal">Msg &amp; data rates may apply. Reply STOP to unsubscribe.</span>
          </span>
        </label>
      </div>
      <div class="nc-form-group nc-form-group--checkbox">
        <label class="nc-checkbox">
          <input type="checkbox" id="email-consent" name="email_consent" checked>
          <span class="nc-checkbox__mark" aria-hidden="true"></span>
          <span class="nc-checkbox__text">Send me sugar reduction tips and early access updates.</span>
        </label>
      </div>
      <button type="submit" class="nc-btn nc-btn--primary nc-btn--full" id="signup-submit-btn">
        <span class="nc-btn__text">See My Results</span>
        <span class="nc-btn__loading" style="display: none;" role="status">
          <span class="nc-spinner" aria-hidden="true"></span>
          <span>Saving...</span>
        </span>
      </button>
      <p class="nc-signup__privacy">&#128274; We respect your privacy. Unsubscribe anytime.</p>
    </form>
  </div>
</section>

{% schema %}
{ "name": "Signup Form", "settings": [] }
{% endschema %}
