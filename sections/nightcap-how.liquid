<section class="nc-how" id="how-it-works" aria-labelledby="how-title">
  <div class="nc-how__container">
    <h2 class="nc-how__title" id="how-title">How It Works</h2>
    <div class="nc-how__steps">
      <div class="nc-how__step">
        <div class="nc-how__step-number">1</div>
        <div class="nc-how__step-icon" aria-hidden="true">&#129504;</div>
        <h3 class="nc-how__step-title">Take the Quiz</h3>
        <p class="nc-how__step-desc">60 seconds. Find out how much sugar you're really consuming from drinks.</p>
      </div>
      <div class="nc-how__connector" aria-hidden="true"></div>
      <div class="nc-how__step">
        <div class="nc-how__step-number">2</div>
        <div class="nc-how__step-icon" aria-hidden="true">&#128233;</div>
        <h3 class="nc-how__step-title">Join the Waitlist</h3>
        <p class="nc-how__step-desc">Get your personalized sugar report and early access to Nightcap.</p>
      </div>
      <div class="nc-how__connector" aria-hidden="true"></div>
      <div class="nc-how__step">
        <div class="nc-how__step-number">3</div>
        <div class="nc-how__step-icon" aria-hidden="true">&#127769;</div>
        <h3 class="nc-how__step-title">Make the Switch</h3>
        <p class="nc-how__step-desc">Replace sugary evening drinks with Nightcap. Sleep better. Feel better.</p>
      </div>
    </div>
  </div>
</section>

